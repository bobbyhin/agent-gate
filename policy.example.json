{
  "default": "allow",
  "rules": [
    {
      "id": "no-self-approval",
      "tool": ["run_command", "run_shell_command", "execute_command", "exec", "shell", "shell_exec", "bash"],
      "args": { "command": { "regex": "approvals\\s+(approve|deny|grant)\\b|tools\\s+accept\\b|\\.agent-gate\\b" } },
      "decision": "block",
      "why": "An agent must not answer its own approval requests, accept a changed tool, or touch the gateway's state."
    },
    {
      "id": "protect-gateway-state",
      "args": { "path": ["*.agent-gate", "*.agent-gate/*"] },
      "decision": "block",
      "why": "The approval queue and the audit log are off limits to agents."
    },
    {
      "id": "shell-guard",
      "type": "shell",
      "tool": ["run_command", "run_shell_command", "execute_command", "exec", "shell", "shell_exec", "bash"],
      "argument": "command"
    },
    {
      "id": "red-line-1-money",
      "toolWords": [
        "pay", "charge", "purchase", "buy", "transfer", "checkout", "refund", "create payment", "place order", "create order",
        "provision", "create instance", "create cluster", "create corpus", "create rag corpus", "create bucket", "enable api", "enable service", "scale up", "create key"
      ],
      "decision": "ask",
      "why": "Red line 1: this tool looks like it spends or moves money, or creates a cloud resource that is billed.",
      "ttlMinutes": 15
    },
    {
      "id": "red-line-2-public",
      "toolWords": ["post", "publish", "send", "tweet", "retweet", "reply", "comment", "email", "share"],
      "decision": "ask",
      "why": "Red line 2: this tool looks like it posts or sends something from a real account."
    },
    {
      "id": "red-line-3-ship",
      "toolWords": ["push", "merge", "deploy", "create pull request", "create pr", "create release"],
      "decision": "ask",
      "why": "Red line 3: this tool looks like a push, merge, pull request, release or deploy.",
      "ttlMinutes": 30
    },
    {
      "id": "red-line-4-delete",
      "toolWords": ["delete", "remove", "drop", "destroy", "overwrite", "purge", "erase", "wipe", "truncate"],
      "decision": "ask",
      "why": "Red line 4: this tool looks like it deletes or overwrites data."
    },
    {
      "id": "red-line-5-memory",
      "toolWords": [
        "remember", "memorize", "add memory", "save memory", "store memory", "update memory", "memory insert", "memory append",
        "memory replace", "add observations", "create entities", "create relations", "set preference", "update profile"
      ],
      "decision": "ask",
      "why": "Red line 5: this tool looks like it writes to long-term memory, which later sessions will read and trust."
    },
    {
      "id": "sql-write",
      "args": { "sql": { "regex": "\\b(?:insert|update|delete|merge|upsert|into|drop|alter|truncate|create|grant|revoke|copy|call|exec|execute)\\b|;\\s*\\S", "flags": "i" } },
      "decision": "ask",
      "why": "This SQL may change data or run more than one statement: it has a write keyword, or more text after a semicolon.",
      "standing": true
    },
    {
      "id": "browser-input",
      "tool": ["browser_*", "puppeteer_*", "playwright_*"],
      "toolWords": ["click", "type", "press", "fill", "submit", "select", "drag", "upload", "evaluate", "run code", "dialog"],
      "decision": "ask",
      "why": "This browser action clicks, types or submits. The gateway sees only the tool's name, not what it acts on.",
      "standing": true
    },
    {
      "id": "browser-read",
      "tool": ["browser_*", "puppeteer_*", "playwright_*"],
      "toolWords": ["screenshot", "snapshot", "read page", "navigate", "console messages", "network requests", "tabs"],
      "decision": "allow",
      "why": "This browser tool only looks at the page."
    }
  ],
  "repeat": [
    {
      "id": "loop-breaker",
      "max": 20,
      "windowSeconds": 60,
      "decision": "ask",
      "why": "The same call already ran 20 times in the last minute without a human; an agent stuck in a loop looks like this."
    }
  ]
}
