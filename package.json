{
  "name": "agent-gate",
  "version": "0.1.0",
  "description": "Guards between an AI agent and its actions: a shell command guard, an MCP gateway that holds risky tool calls for a human, and an LLM gateway with routing, budget caps and a leak guard.",
  "license": "MIT",
  "author": "Bodinwit Jitsomruetaikul",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bobbyhin/agent-gate.git"
  },
  "private": false,
  "main": "src/command-guard.js",
  "bin": {
    "agent-gate": "bin/agent-gate.js",
    "agent-gate-hook": "bin/claude-pretooluse-hook.js"
  },
  "imports": {
    "#command-guard": "./src/command-guard.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test test/*.test.js dist/test/gateway/*.test.js dist/test/llm/*.test.js",
    "redteam": "node scripts/redteam.js",
    "demo": "node scripts/demo-transcript.js",
    "demo:llm": "node scripts/demo-llm-transcript.js",
    "demo:approvals": "node scripts/demo-approvals.js",
    "loadtest": "node scripts/loadtest.js",
    "bench": "node scripts/bench.js"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ai-agents",
    "claude-code",
    "pretooluse-hook",
    "shell",
    "guardrails",
    "mcp",
    "mcp-gateway",
    "human-in-the-loop",
    "llm-gateway",
    "budget-caps",
    "secret-scanning"
  ],
  "devDependencies": {
    "@modelcontextprotocol/server-filesystem": "1.0.0",
    "@types/node": "^20.19.43",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  }
}
